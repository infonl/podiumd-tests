{
  "display": "form",
  "name": "ptestSelectDocumentsForm",
  "title": "Select documents",
  "path": "ptestselectdocumentsform",
  "type": "form",
  "components": [
    {
      "type": "textfield",
      "key": "ptestZaakFataleDatum",
      "label": "Fatale datum of the zaak",
      "defaultValue": "ZAAK:FATALE_DATUM",
      "input": true
    },
    {
      "type": "textfield",
      "key": "ptestZaakBehandelaar",
      "label": "Behandelaar of the zaak",
      "defaultValue": "ZAAK:BEHANDELAAR",
      "input": true
    },
    {
      "type": "textfield",
      "key": "ptestCommunicatiekanaal",
      "label": "Communicatiekanaal of the zaak",
      "defaultValue": ":zaakCommunicatiekanaal",
      "input": true
    },
    {
      "type": "datagrid",
      "key": "ZAAK_Documenten_Ondertekenen_Selectie",
      "label": "Documents to sign",
      "input": true,
      "components": [
        {
          "type": "checkbox",
          "key": "selected",
          "label": "Selected",
          "input": true
        },
        {
          "type": "textfield",
          "key": "titel",
          "label": "Titel",
          "input": true
        }
      ]
    },
    {
      "type": "button",
      "key": "submit",
      "label": "Submit",
      "action": "submit",
      "input": true
    }
  ]
}
